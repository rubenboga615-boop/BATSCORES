# ---------------------------------------------------------------------------
# BATSCORES - Configuration
# Copiez ce fichier en ".env" puis renseignez votre cle API.
# ---------------------------------------------------------------------------

# Votre cle API-Football (plan Pro).
API_FOOTBALL_KEY=votre_cle_api_ici

# Fournisseur de la cle :
#   apisports  -> vous vous etes inscrit sur https://dashboard.api-football.com (par defaut)
#   rapidapi   -> vous avez souscrit via RapidAPI
API_FOOTBALL_PROVIDER=apisports

# Port d'ecoute du serveur
PORT=3000

# Fuseau horaire utilise pour l'affichage des rencontres
DEFAULT_TIMEZONE=Europe/Paris

# Nombre maximum d'appels par minute envoyes au fournisseur.
# Plan Pro = 300/min. On garde une marge de securite.
RATE_LIMIT_PER_MINUTE=280

# Optionnel : pointer vers un autre serveur (tests hors ligne).
# Laissez vide en production.
# API_FOOTBALL_BASE_URL=

# Pilotage du collecteur depuis l'interface web.
# Laissez vide pour n'autoriser que la consultation : personne ne pourra
# lancer une collecte depuis le navigateur, et donc consommer votre quota.
# Renseignez une phrase secrete pour activer les boutons de lancement.
COLLECTOR_ADMIN_TOKEN=

# Plafond d'appels par jour de votre plan (Pro = 7500)
API_FOOTBALL_DAILY_LIMIT=7500
